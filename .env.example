# App Environment
APP_ENV=development
USE_MOCK_NIPOST=true

# NIPOST Postcode API (https://api.postcode.gov.ng)
NIPOST_BASE_URL=https://api.postcode.gov.ng
NIPOST_SECRET_KEY=nipost_test_replace_me
NIPOST_PUBLISHABLE_KEY=nipost_pk_replace_me
ALLOWED_ORIGIN=http://localhost:3000

# Supabase PostgreSQL + PostGIS Connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Security & NIN Hashing (sha256(NIN + pepper + app_salt))
NIN_PEPPER=rotate_every_90_days_secret_pepper
APP_SALT=findam_app_salt_2026
JWT_SECRET=findam_jwt_signing_secret

# Termii SMS / USSD
TERMII_API_KEY=termii_test_replace_me
